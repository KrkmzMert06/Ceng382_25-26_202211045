@model CaterFlow.Models.ViewModels.LogListViewModel
@{
    ViewData["Title"] = "System Logs";
}

<div class="page-header">
    <div>
        <h1>📝 System Logs</h1>
        <p class="muted">Review system activities, authentication events, orders, payments, and errors.</p>
    </div>
</div>

<!-- Filters -->
<div class="log-filter-card">
    <form method="get" asp-action="Logs" class="log-filter-form">
        <div class="log-filter-row">
            <div>
                <label>Event Type</label>
                <select name="eventType" id="eventTypeSelect">
                    <option value="">All Types</option>
                    @foreach (var type in new[] { "Auth", "Order", "Payment", "Rating", "Error", "System" })
                    {
                        if (Model.FilterEventType == type)
                        {
                            <option value="@type" selected="selected">@type</option>
                        }
                        else
                        {
                            <option value="@type">@type</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label>Level</label>
                <select name="level" id="levelSelect">
                    <option value="">All Levels</option>
                    @foreach (var lvl in new[] { "Info", "Warning", "Error" })
                    {
                        if (Model.FilterLevel == lvl)
                        {
                            <option value="@lvl" selected="selected">@lvl</option>
                        }
                        else
                        {
                            <option value="@lvl">@lvl</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label>Search</label>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search logs..." />
            </div>
            <div style="display:flex;align-items:end;gap:8px;">
                <button type="submit" class="primary-button">Filter</button>
                <a asp-action="Logs" class="secondary-button">Reset</a>
            </div>
        </div>
    </form>
</div>

<!-- Log Table -->
@if (!Model.Logs.Any())
{
    <div class="empty-state">No log entries found matching your criteria.</div>
}
else
{
    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Time</th>
                    <th>Type</th>
                    <th>Level</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>User</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    var levelClass = log.Level switch
                    {
                        "Error" => "log-error",
                        "Warning" => "log-warning",
                        _ => "log-info"
                    };
                    <tr class="@levelClass">
                        <td>@log.Id</td>
                        <td>@log.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td><span class="log-type-badge">@log.EventType</span></td>
                        <td><span class="log-level-badge log-level-@log.Level.ToLower()">@log.Level</span></td>
                        <td>@log.Action</td>
                        <td class="log-details">@(log.Details ?? "—")</td>
                        <td>@(log.UserEmail ?? "—")</td>
                        <td>@(log.IpAddress ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Logs"
                   asp-route-eventType="@Model.FilterEventType"
                   asp-route-level="@Model.FilterLevel"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   class="page-link">← Prev</a>
            }
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <a asp-action="Logs"
                   asp-route-eventType="@Model.FilterEventType"
                   asp-route-level="@Model.FilterLevel"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-page="@p"
                   class="page-link @(p == Model.CurrentPage ? "active" : "")">@p</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Logs"
                   asp-route-eventType="@Model.FilterEventType"
                   asp-route-level="@Model.FilterLevel"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   class="page-link">Next →</a>
            }
        </div>
    }
}
