@model CaterFlow.Models.ViewModels.OrderHistoryListViewModel
@{
    ViewData["Title"] = "My Orders";
}

<div class="page-header"><h1>My Orders</h1></div>

<div class="log-filter-card">
    <form method="get" asp-action="Orders" class="log-filter-form">
        <div class="order-filter-row">
            <div>
                <label>Status</label>
                <select name="status">
                    <option value="">All Statuses</option>
                    @foreach (var status in new[] { "Pending", "Completed", "Cancelled" })
                    {
                        if (Model.StatusFilter == status)
                        {
                            <option value="@status" selected="selected">@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label>Search</label>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Order no or item name" />
            </div>
            <div class="filter-actions">
                <button type="submit" class="primary-button">Filter</button>
                <a asp-action="Orders" class="secondary-button">Reset</a>
            </div>
        </div>
    </form>
</div>

@if (!Model.Orders.Any())
{
    <div class="empty-state">No orders yet.</div>
}
else
{
    <div class="table-card">
        <table class="data-table">
            <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Items</th><th>Total</th><th></th></tr></thead>
            <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td><span class="status-badge status-@order.Status.ToLower()">@order.Status</span></td>
                    <td>@order.ItemCount</td>
                    <td>@order.TotalPrice.ToString("C")</td>
                    <td class="table-actions">
                        <a asp-action="Details" asp-route-id="@order.Id" class="secondary-button small-btn">Details</a>
                        <a asp-action="Receipt" asp-route-id="@order.Id" class="secondary-button small-btn">Receipt</a>
                        @if (order.Status == "Completed")
                        {
                            <a asp-controller="Rating" asp-action="Rate" asp-route-orderId="@order.Id" class="primary-button small-btn">Rate</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Orders"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   class="page-link">Prev</a>
            }
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <a asp-action="Orders"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-page="@p"
                   class="page-link @(p == Model.CurrentPage ? "active" : "")">@p</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Orders"
                   asp-route-status="@Model.StatusFilter"
                   asp-route-search="@Model.SearchTerm"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   class="page-link">Next</a>
            }
        </div>
    }
}
