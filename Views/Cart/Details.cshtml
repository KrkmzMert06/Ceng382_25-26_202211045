@model CaterFlow.Models.ViewModels.OrderDetailsViewModel
@{
    ViewData["Title"] = "Order Details";
}

<div class="page-header">
    <div>
        <h1>Order #@Model.Id</h1>
        <p class="muted">
            <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
            Created: @Model.CreatedAt.ToLocalTime().ToString("g")
        </p>
    </div>
    <div class="button-row">
        @if (Model.Status == "Completed" && !Model.HasBeenRated)
        {
            <a asp-controller="Rating" asp-action="Rate" asp-route-orderId="@Model.Id" class="primary-button">⭐ Rate This Order</a>
        }
        else if (Model.HasBeenRated)
        {
            <span class="badge badge-green">Rated</span>
        }
        <a asp-action="Receipt" asp-route-id="@Model.Id" class="secondary-button">Receipt</a>
        <a asp-action="Agreement" asp-route-id="@Model.Id" class="secondary-button">Agreement</a>
        <a asp-action="Orders" class="secondary-button">Back to Orders</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">@TempData["Success"]</div>
}

<div class="table-card">
    @foreach (var item in Model.Items)
    {
        <div class="summary-line">
            <div>
                <strong>@item.MenuItemName</strong> x @item.Quantity<br />
                <span class="muted">Base: @item.UnitPrice.ToString("C") | Customizations: @item.CustomizationTotal.ToString("C")</span>
                @if (item.SelectedCustomizations.Any())
                {
                    <ul class="compact-list">
                    @foreach (var opt in item.SelectedCustomizations)
                    {
                        var optionText = opt.IsRemovableIngredient ? $"Remove {opt.OptionName}" : opt.OptionName;
                        <li>@opt.GroupName: @optionText @if (opt.PriceModifier != 0) { <span>(+@opt.PriceModifier.ToString("C"))</span> }</li>
                    }
                    </ul>
                }
            </div>
            <strong>@item.LineTotal.ToString("C")</strong>
        </div>
    }
    <hr />
    <h3>Total: @Model.TotalPrice.ToString("C")</h3>
</div>
