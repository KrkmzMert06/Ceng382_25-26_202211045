@model IEnumerable<CaterFlow.Models.ViewModels.HomeMenuItemViewModel>
@{
    ViewData["Title"] = "Available Menus";
}

<div class="page-header">
    <div>
        <h1>Available Menus</h1>
        <p class="muted">Choose menu items, select customizations and add them to your cart.</p>
    </div>
</div>

@if (TempData["CartMessage"] != null)
{
    <div class="alert-success">@TempData["CartMessage"]</div>
}

@if (!Model.Any())
{
    <div class="empty-state">No menu items have been created yet.</div>
}
else
{
    <div class="menu-grid">
        @foreach (var item in Model)
        {
            var imageSrc = string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/no-image.svg" : item.ImageUrl;
            <div class="menu-card">
                <img src="@imageSrc" alt="@item.Name" class="menu-image" onerror="this.onerror=null;this.src='/images/no-image.svg';" />
                <h3>@item.Name</h3>
                <p>@item.Description</p>
                <div class="menu-meta">
                    <span>Caterer: @item.CatererName</span>
                    <strong>@item.Price.ToString("C")</strong>
                </div>

                <form asp-controller="Cart" asp-action="Add" method="post" class="cart-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MenuItemId" value="@item.Id" />

                    @if (item.CustomizationGroups.Any())
                    {
                        <div class="customization-list">
                            <strong>Customization Options</strong>
                            @foreach (var group in item.CustomizationGroups)
                            {
                                <div class="customization-group">
                                    <span class="group-title">
                                        @group.Name
                                        @(group.IsRequired ? "(required)" : "")
                                    </span>
                                    @if (group.AllowsMultipleSelection)
                                    {
                                        <ul>
                                            @foreach (var option in group.Options)
                                            {
                                                var optionText = option.IsRemovableIngredient ? $"Remove {option.Name}" : option.Name;
                                                <li>
                                                    <label class="option-row">
                                                        <input type="checkbox" name="SelectedOptionIds" value="@option.Id" />
                                                        <span>@optionText</span>
                                                        @if (option.PriceModifier != 0)
                                                        {
                                                            <span class="price-mod">+@option.PriceModifier.ToString("C")</span>
                                                        }
                                                    </label>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <select name="SelectedOptionIds" class="single-option-select" required="@group.IsRequired">
                                            @if (!group.IsRequired)
                                            {
                                                <option value="0">No selection</option>
                                            }
                                            @foreach (var option in group.Options)
                                            {
                                                var optionText = option.IsRemovableIngredient ? $"Remove {option.Name}" : option.Name;
                                                var priceText = option.PriceModifier == 0 ? "" : $" (+{option.PriceModifier.ToString("C")})";
                                                <option value="@option.Id">@optionText@priceText</option>
                                            }
                                        </select>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="customization-list muted">No customization options.</div>
                    }

                    <div class="cart-actions-row">
                        <label>Qty <input type="number" name="Quantity" value="1" min="1" max="99" class="qty-input" /></label>
                        <button type="submit" class="primary-button">Add to Cart</button>
                    </div>
                </form>
            </div>
        }
    </div>
}
