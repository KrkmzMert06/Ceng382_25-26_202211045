@model IEnumerable<CaterFlow.Models.ViewModels.NearbyRestaurantViewModel>
@{
    ViewData["Title"] = "Restaurants";
    var hasLocation = (bool)(ViewBag.HasLocation ?? false);
    var userLat = ViewBag.UserLat as double?;
    var userLng = ViewBag.UserLng as double?;
    var maxDist = (double)(ViewBag.MaxDistance ?? 50);
    var apiKey = ViewContext.HttpContext.RequestServices.GetRequiredService<IConfiguration>()["GoogleMaps:ApiKey"] ?? "";
}

<section class="food-hero">
    <div class="food-hero-content">
        <span class="eyebrow">WeHungry</span>
        <h1>Find restaurants and catering menus.</h1>
        <p>Explore restaurants, customize dishes and order catering. Sign in to find nearby options.</p>
        <form method="get" asp-action="Index" class="hero-location-form">
            <input type="hidden" id="filterLat" name="lat" value="@(userLat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
            <input type="hidden" id="filterLng" name="lng" value="@(userLng?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
            <button type="button" id="btnDetectLocation" class="secondary-button" onclick="detectLocation()">
                <span class="app-icon">📍</span> Use my location
            </button>
            @{
                var distances = new[] { 5.0, 10.0, 25.0, 50.0, 100.0, 500.0 };
            }
            <select name="maxDistance" class="distance-select" id="distanceSelect">
                @foreach (var d in distances)
                {
                    if (maxDist == d)
                    {
                        <option value="@d" selected="selected">@d km</option>
                    }
                    else
                    {
                        <option value="@d">@d km</option>
                    }
                }
            </select>
            <button type="submit" class="primary-button">Show restaurants</button>
        </form>
        <p id="locationStatus" class="hero-location-status">
            @if (hasLocation)
            {
                <text>Showing restaurants within @maxDist km of your delivery location.</text>
            }
            else
            {
                <text>Showing all restaurants. Sign in or use your location to find nearby options first.</text>
            }
        </p>
    </div>
</section>

@if (TempData["CartMessage"] != null)
{
    <div class="alert-success">@TempData["CartMessage"]</div>
}

@if (hasLocation)
{
    <div id="map" class="google-map"></div>
}

<div class="section-heading">
    <div>
        <h2>@(hasLocation ? "Restaurants near you" : "All restaurants")</h2>
        <p class="muted">Choose a restaurant to view its full menu.</p>
    </div>
    <a asp-controller="Account" asp-action="UpdateLocation" class="secondary-button">Change delivery location</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">No restaurants found in this area. Try increasing your distance or update your delivery location.</div>
}
else
{
    <div class="restaurant-grid">
        @foreach (var restaurant in Model)
        {
            var imageSrc = string.IsNullOrWhiteSpace(restaurant.CoverImageUrl) ? "/images/no-image.svg" : restaurant.CoverImageUrl;
            <a asp-action="Details"
               asp-route-id="@restaurant.Id"
               asp-route-lat="@userLat"
               asp-route-lng="@userLng"
               asp-route-maxDistance="@maxDist"
               class="restaurant-card">
                <img src="@imageSrc" alt="@restaurant.BusinessName" onerror="this.onerror=null;this.src='/images/no-image.svg';" />
                <div class="restaurant-card-body">
                    <div class="restaurant-title-row">
                        <h3>@restaurant.BusinessName</h3>
                        @if (restaurant.AverageRating > 0)
                        {
                            <span class="rating-badge">⭐ @restaurant.AverageRating.ToString("F1")</span>
                        }
                        else
                        {
                            <span class="rating-badge muted">New</span>
                        }
                    </div>
                    <p>@(restaurant.Description ?? "Fresh catering menu available for delivery.")</p>
                    <div class="restaurant-meta-row">
                        <span><span class="app-icon">🍽</span> @restaurant.MenuItemCount menu items</span>
                        @if (restaurant.StartingPrice > 0)
                        {
                            <span>From @restaurant.StartingPrice.ToString("C")</span>
                        }
                        @if (hasLocation && restaurant.DistanceKm > 0)
                        {
                            <span><span class="app-icon">📍</span> @restaurant.DistanceKm.ToString("F1") km</span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}

@section Scripts {
    <script>
        function detectLocation() {
            var status = document.getElementById('locationStatus');
            if (!navigator.geolocation) {
                status.textContent = 'Your browser does not support location detection.';
                return;
            }
            status.textContent = 'Finding your location...';
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    document.getElementById('filterLat').value = position.coords.latitude;
                    document.getElementById('filterLng').value = position.coords.longitude;
                    status.textContent = 'Location found. Click "Show restaurants" to update the list.';
                },
                function() {
                    status.textContent = 'Could not detect your location. You can update it from delivery location.';
                }
            );
        }
    </script>
    @if (hasLocation)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var userLat = @(userLat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0");
                var userLng = @(userLng?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0");
                
                var map = L.map('map').setView([userLat, userLng], 12);
                
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);

                // User Location Marker
                L.marker([userLat, userLng]).addTo(map)
                    .bindPopup('<b>Your Delivery Location</b>').openPopup();

                // Restaurant Markers
                @foreach (var restaurant in Model.Where(i => i.CatererLat != 0 && i.CatererLng != 0))
                {
                    <text>
                    L.marker([@restaurant.CatererLat.ToString(System.Globalization.CultureInfo.InvariantCulture), @restaurant.CatererLng.ToString(System.Globalization.CultureInfo.InvariantCulture)])
                        .addTo(map)
                        .bindPopup('<b>@Html.Raw(restaurant.BusinessName.Replace("'", "\\'"))</b><br>@restaurant.DistanceKm.ToString("F1") km away');
                    </text>
                }
            });
        </script>
    }
}
