@{
    ViewData["Title"] = "Update Location";
    var currentLat = ViewBag.CurrentLat as double?;
    var currentLng = ViewBag.CurrentLng as double?;
    var currentAddress = ViewBag.CurrentAddress as string;
    var apiKey = ViewContext.HttpContext.RequestServices.GetRequiredService<IConfiguration>()["GoogleMaps:ApiKey"] ?? "";
}

<div class="page-header">
    <div>
        <h1>📍 Update Your Location</h1>
        <p class="muted">Set your location so we can show you nearby caterers and calculate delivery distances.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">@TempData["Success"]</div>
}

<div class="form-card" style="max-width:600px;">
    <form asp-action="UpdateLocation" method="post">
        @Html.AntiForgeryToken()

        <div class="form-grid">
            <div>
                <label><strong>Current Location:</strong></label>
                @if (currentLat.HasValue && currentLng.HasValue)
                {
                    <p>Lat: @currentLat.Value.ToString("F6"), Lng: @currentLng.Value.ToString("F6")</p>
                    @if (!string.IsNullOrWhiteSpace(currentAddress))
                    {
                        <p class="muted">@currentAddress</p>
                    }
                }
                else
                {
                    <p class="muted">No location set yet.</p>
                }
            </div>

            <div>
                <label for="latitude">Latitude</label>
                <input type="number" id="latitude" name="latitude" step="0.000001" required
                       value="@(currentLat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                       placeholder="e.g. 39.9208" />
            </div>

            <div>
                <label for="longitude">Longitude</label>
                <input type="number" id="longitude" name="longitude" step="0.000001" required
                       value="@(currentLng?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                       placeholder="e.g. 32.8541" />
            </div>

            <div>
                <label for="address">Address (optional)</label>
                <input type="text" id="address" name="address"
                       value="@(currentAddress ?? "")"
                       placeholder="Enter your address..." />
            </div>

            <div class="button-row">
                <button type="button" class="secondary-button" onclick="detectMyLocation()">
                    📍 Auto-detect Location
                </button>
                <button type="submit" class="primary-button">Save Location</button>
            </div>
        </div>
    </form>
</div>

    <div id="locationMap" class="google-map" style="margin-top:20px;"></div>

@section Scripts {
    <script>
        function detectMyLocation() {
            if (!navigator.geolocation) {
                alert('Geolocation is not supported by your browser.');
                return;
            }
            navigator.geolocation.getCurrentPosition(
                function(position) {
                    document.getElementById('latitude').value = position.coords.latitude.toFixed(6);
                    document.getElementById('longitude').value = position.coords.longitude.toFixed(6);
                    if (typeof updateMap === 'function') {
                        updateMap(position.coords.latitude, position.coords.longitude);
                    }
                },
                function(error) {
                    alert('Unable to detect location: ' + error.message);
                }
            );
        }
    </script>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            var map, marker;
            document.addEventListener('DOMContentLoaded', function() {
                var lat = parseFloat(document.getElementById('latitude').value) || 39.9208;
                var lng = parseFloat(document.getElementById('longitude').value) || 32.8541;
                
                // Initialize Leaflet map
                map = L.map('locationMap').setView([lat, lng], 14);
                
                // Add OpenStreetMap tiles
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);

                // Add draggable marker
                marker = L.marker([lat, lng], {draggable: true}).addTo(map);

                // Update inputs on drag end
                marker.on('dragend', function(e) {
                    var pos = marker.getLatLng();
                    document.getElementById('latitude').value = pos.lat.toFixed(6);
                    document.getElementById('longitude').value = pos.lng.toFixed(6);
                });

                // Update marker and inputs on map click
                map.on('click', function(e) {
                    marker.setLatLng(e.latlng);
                    document.getElementById('latitude').value = e.latlng.lat.toFixed(6);
                    document.getElementById('longitude').value = e.latlng.lng.toFixed(6);
                });
            });

            function updateMap(lat, lng) {
                if (map && marker) {
                    var pos = [lat, lng];
                    map.setView(pos, 14);
                    marker.setLatLng(pos);
                }
            }
        </script>
}
